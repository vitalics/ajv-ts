{
  "name": "ajv-ts",
  "description": "JSON-schema builder with typescript safety",
  "version": "0.11.0",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "tsx ./tsup.config.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check",
    "lint:fix": "biome check --write src/ tests/",
    "lint:ci": "biome ci src/ tests/",
    "ci:version": "changeset version",
    "ci:publish": "changeset publish"
  },
  "author": "Vitali Haradkou <vitalicset@yandex.ru>",
  "homepage": "https://github.com/vitalics/ajv-ts",
  "keywords": [
    "ajv",
    "validation",
    "json-schema",
    "typescript",
    "builder"
  ],
  "bugs": {
    "url": "https://github.com/vitalics/ajv-ts/issues",
    "email": "vitalicset@yandex.ru"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@changesets/changelog-github": "0.5.0",
    "@changesets/cli": "2.26.2",
    "@types/benchmark": "^2.1.5",
    "@vitest/ui": "^3.2.6",
    "benchmark": "2.1.4",
    "expect-type": "^1.4.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "5.5.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "ajv": "^8.18.0",
    "ajv-errors": "3.0.0",
    "ajv-formats": "3.0.1",
    "type-fest": "4.26.0"
  }
}
